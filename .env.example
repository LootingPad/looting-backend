# PostgreSQL — local docker compose, or paste Railway DATABASE_URL from the dashboard
# (not postgres.railway.internal — that only works inside Railway).
DATABASE_URL=postgresql://looting:looting@localhost:5432/looting?schema=public

# Robinhood Chain via Phantom node proxy
RPC_HTTP_URL=https://node-proxy.phantom.app/v1/chain/robinhood/network/mainnet
RPC_WS_URL=
CHAIN_ID=4663

# Mobula — charts + metadata. Never commit a real key.
MOBULA_API_KEY=
MOBULA_BASE_URL=https://api.mobula.io

# Uniswap on Robinhood (chainId 4663)
UNI_UNIVERSAL_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
UNI_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
UNI_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
UNI_V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
UNI_V3_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
UNI_V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# LOOTING contracts — fill from looting-contracts deployments/<chainId>.json after deploy
LAUNCH_REGISTRY_ADDRESS=
DEV_LOCK_ADDRESS=
STAKING_FACTORY_ADDRESS=

# Ops — never expose to the frontend
KEEPER_PRIVATE_KEY=
ADMIN_API_TOKEN=change-me

# Pons V2 factory on Robinhood. New-pair identity is indexed from this contract.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
TRENCH_POLL_MS=200
TRENCH_CONFIRMATIONS=0
TRENCH_LOG_CHUNK=99

# Indexer
INDEXER_ENABLED=true
ENABLE_TRADE_INDEXING=false
INDEXER_POLL_MS=4000
INDEXER_CONFIRMATIONS=8
INDEXER_START_BLOCK=0

# Receives the flat $0.056 fee on every buy and sell.
TRADE_FEE_WALLET=

# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
