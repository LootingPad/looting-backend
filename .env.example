# PostgreSQL — local docker compose, or paste Railway DATABASE_URL from the dashboard
# (not postgres.railway.internal — that only works inside Railway).
DATABASE_URL=postgresql://looting:looting@localhost:5432/looting?schema=public

# Robinhood Chain via Phantom node proxy
RPC_HTTP_URL=https://node-proxy.phantom.app/v1/chain/robinhood/network/mainnet
RPC_WS_URL=
CHAIN_ID=4663

# Mobula — charts + metadata. Never commit a real key.
MOBULA_API_KEY=
MOBULA_BASE_URL=https://api.mobula.io

# Uniswap on Robinhood (chainId 4663)
UNI_UNIVERSAL_ROUTER=0x8876789976decbfcbbbe364623c63652db8c0904
UNI_PERMIT2=0x000000000022D473030F116dDEE9F6B43aC78BA3
UNI_V4_POOL_MANAGER=0x8366a39cc670b4001a1121b8f6a443a643e40951
UNI_V4_QUOTER=0x8dc178efb8111bb0973dd9d722ebeff267c98f94
UNI_V3_SWAP_ROUTER=0xCaf681a66D020601342297493863E78C959E5cb2
UNI_V3_QUOTER=0x33e885eD0Ec9bF04EcfB19341582aADCb4c8A9E7
WETH_ADDRESS=0x4200000000000000000000000000000000000006

# LOOTING contracts — fill from looting-contracts deployments/<chainId>.json after deploy
LAUNCH_REGISTRY_ADDRESS=
DEV_LOCK_ADDRESS=
STAKING_FACTORY_ADDRESS=

# Ops — never expose to the frontend
KEEPER_PRIVATE_KEY=
ADMIN_API_TOKEN=change-me

# Pons V2 factory on Robinhood. New-pair identity is indexed from this contract.
PONS_V2_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# Optional: LootingLaunchRouter — one wallet confirm for Pons launchFee + LOOTING 0.00035
# LOOTING_LAUNCH_ROUTER=0x96C7e2B5715EBAC72122e2c7c96a5aF94976c303
# Optional: LootingRewardRouter — creatorFeeRecipient + claimCreator / sweep+harvest target
# LOOTING_REWARD_ROUTER=0xAE92A87c129Ece0f999201FE80b2d19F02923192
# Optional: interim ETH lucky-box payout module
# LOOTING_LUCKY_BOX_ETH_MODULE=0x80901944818c6661287Bb5933E4BA49A07e41BF0
# Pons FeeEscrow (balances after BondingCurve.sweepFees)
# PONS_FEE_ESCROW=0xd3AFEB2a57f70eF218Aa82451c51B2fb0416Ac9e
# Optional: burn-budget pull destination (ops buy+burn)
# BURN_WALLET=0xD712570969461D9f736a76e290a4Ee700509a59B
TRENCH_POLL_MS=200
TRENCH_CONFIRMATIONS=0
TRENCH_LOG_CHUNK=99

# Indexer
INDEXER_ENABLED=true
ENABLE_TRADE_INDEXING=true
# Explore coins: DexScreener (Migrate) + ponsapi live New Pair
ENABLE_DEXSCREENER_FEED=true
# Never commit a real key — https://ponsapi.dev/docs
PONSAPI_API_KEY=
PONSAPI_BASE_URL=https://api.ponsapi.dev
PONSAPI_WS_URL=wss://api.ponsapi.dev/v1/ws
INDEXER_POLL_MS=4000
INDEXER_CONFIRMATIONS=8
INDEXER_START_BLOCK=0

# Receives the flat $0.056 fee on every buy and sell.
TRADE_FEE_WALLET=

# Receives LOOTING's 0.00035 ETH share of the 0.00085 create fee (Pons takes 0.0005).
LAUNCH_FEE_WALLET=0xD712570969461D9f736a76e290a4Ee700509a59B

# Absolute origin for HTTPS media fallback (GMGN/Axiom). Prefer IPFS when PINATA_JWT is set.
PUBLIC_API_BASE=https://api.lootingpad.com

# Pinata JWT — pins launch logos to public IPFS (ipfs://CID on-chain). Free at pinata.cloud.
PINATA_JWT=

# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
