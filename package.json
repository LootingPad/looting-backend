{
  "name": "looting-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:indexer": "tsx watch src/indexer/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "start:indexer": "node dist/indexer/worker.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@prisma/client": "^6.5.0",
    "@types/node": "^22.13.10",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "prisma": "^6.5.0",
    "typescript": "^5.8.2",
    "viem": "^2.23.2",
    "ws": "^8.22.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3"
  }
}
